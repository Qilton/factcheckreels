{
  "name": "reelcheck-backend",
  "version": "1.0.0",
  "description": "Fastify backend for ReelCheck Instagram reel fact-checker with Gemini Flash search grounding",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
